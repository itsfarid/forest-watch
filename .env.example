# ============================================================
# Forest Watch AI -- Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# OpenAI (REQUIRED)
# ------------------------------------------------------------
# API key for chat completion (text responses after image analysis)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------
# Roboflow (REQUIRED -- at least one inference target must be set)
# ------------------------------------------------------------
# API key for Roboflow inference
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Primary model ID in format "project-name/version" (e.g. deforestation-detection-ivd96/5)
ROBOFLOW_MODEL_ID=your_project_name/version_number

# Alternative: custom self-hosted inference server URL (optional, overrides MODEL_ID)
# ROBOFLOW_INFERENCE_URL=https://your-inference-server.example.com/infer

# Alternative: model ID for detect.roboflow.com endpoint (optional, falls back if MODEL_ID fails)
# ROBOFLOW_DETECT_MODEL=your_project_name/version_number

# ------------------------------------------------------------
# Roboflow Tuning (OPTIONAL -- safe defaults provided)
# ------------------------------------------------------------
# Confidence threshold for deforestation detection (0.0-1.0)
# Lower = more detections but higher chance of false positives
# Higher = fewer detections but more precise results
# Default: 0.5 -- recommended range: 0.4-0.7
# Can also be adjusted live via the UI sensitivity slider
ROBOFLOW_CONFIDENCE_THRESHOLD=0.5

# Overlap threshold for bounding box deduplication/NMS (0.0-1.0)
# Controls how much two boxes can overlap before one is removed
# Default: 0.5 -- standard value, rarely needs changing
ROBOFLOW_OVERLAP_THRESHOLD=0.5

# Enable debug mode -- returns visualization even when no predictions found (true/false)
# Default: false
# ROBOFLOW_DEBUG=false

OPENAI_API_KEY=placeholder_key

# Roboflow configuration
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_MODEL_ID=your_model_id/version_number

# Confidence threshold for deforestation detection (0.0–1.0)
# Lower = more detections but higher chance of false positives
# Higher = fewer detections but more precise results
# Default: 0.5 — good balance for environmental monitoring
# Recommended range: 0.4–0.7
ROBOFLOW_CONFIDENCE_THRESHOLD=0.5

# Overlap threshold for bounding box deduplication (0.0–1.0)
# Controls how much two boxes can overlap before one is removed (NMS)
# Default: 0.5 — standard value, rarely needs changing
ROBOFLOW_OVERLAP_THRESHOLD=0.5
